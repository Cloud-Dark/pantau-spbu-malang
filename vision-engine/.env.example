# Salin ke .env (tidak ikut git). Jangan komit rahasia.
# Opsional: ENV_FILE=/path/ke/file.env untuk memuat file env lain.

# --- Wajib ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Umum ---
# 1 = hanya log, tidak menulis ke status_logs
DRY_RUN=0
# Jeda minimum (menit) sebelum status SAMA ditulis ulang per SPBU+sumber (heartbeat)
DEDUPE_HEARTBEAT_MIN=30

# --- Traffic API (primary trigger) ---
TRAFFIC_PROVIDER=tomtom
# Kosong = pemantauan lalu lintas dinonaktifkan (bukan error)
TRAFFIC_API_KEY=
TRAFFIC_INTERVAL_SEC=300
TRAFFIC_CONCURRENCY=4
TRAFFIC_TIMEOUT_MS=8000
TRAFFIC_RETRIES=2
# currentSpeed/freeFlowSpeed >= nilai ini = NORMAL, di bawahnya = ANTRE_PANJANG
TRAFFIC_NORMAL_RATIO=0.7
# Abaikan bacaan dengan confidence API (0-1) di bawah nilai ini
TRAFFIC_MIN_API_CONFIDENCE=0.3

# --- CCTV (validasi, opsional) ---
CCTV_SOURCES_FILE=cctv-sources.json
CCTV_INTERVAL_SEC=120
CCTV_TIMEOUT_MS=15000
# Default jumlah kendaraan dalam ROI yang dianggap antrean panjang (bisa di-override per sumber lewat "capacity")
CCTV_QUEUE_THRESHOLD=8
FFMPEG_PATH=ffmpeg
# Model YOLOv8 ONNX (COCO). Kosong = deteksi CCTV dinonaktifkan
YOLO_MODEL_PATH=
YOLO_SCORE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.5
