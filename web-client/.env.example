# Salin ke .env.local lalu isi. JANGAN komit nilai rahasia.
DATABASE_URL=

# --- Fase 4: notifikasi & cron ---
# Wajib untuk /api/cron/notify (Authorization: Bearer <CRON_SECRET>). Kosong = endpoint selalu 401.
CRON_SECRET=
# Telegram Bot API (kosong = kanal nonaktif)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp via webhook generik: POST JSON {text, source, type}; token opsional dikirim sebagai Bearer
# (kosong = kanal nonaktif). Arahkan ke gateway/otomasi apa pun yang menerima field "text".
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# Ambang (default 70) dan cooldown menit (default 60)
CRITICAL_MIN_CONFIDENCE=70
NOTIFY_COOLDOWN_MINUTES=60
# Untuk tautan peta di pesan (opsional)
NEXT_PUBLIC_SITE_URL=
# Opsional: jendela data & half-life confidence (menit; default 30 dan 10)
CONFIDENCE_WINDOW_MINUTES=30
CONFIDENCE_HALF_LIFE_MINUTES=10
